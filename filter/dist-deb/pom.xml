<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-message-sluice-filter-parent</artifactId>
        <version>0.4.1-SNAPSHOT</version>
    </parent>

    <artifactId>sokar-message-sluice-filter-deb</artifactId>
    <packaging>pom</packaging>
    <name>sokar-message-sluice-filter (.deb)</name>
    <description>The .deb package of sokar-message-sluice-filter</description>

    <!-- The native binary is not a Maven artifact, so it is found by path. The dependency only puts
         this module after the one that builds it. -->

    <dependencies>
        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-message-sluice-filter</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>

            <!-- On verify, not package: native-image runs on package, and a packaging plugin there
                 would pack the binary of the build before. -->

            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb.version}</version>
                <executions>
                    <execution>
                        <id>deb</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <!-- This module packs a file and builds nothing, so it is 'pom' packaged,
                                 which jdeb would otherwise skip. -->
                            <skipPOMs>false</skipPOMs>
                            <controlDir>${project.basedir}/src/deb</controlDir>
                            <deb>${project.build.directory}/sokar-message-sluice-filter_${sluice.package.version}_amd64.deb</deb>
                            <dataSet>
                                <data>
                                    <src>${project.basedir}/../app/target/sokar-message-sluice-filter</src>
                                    <type>file</type>
                                    <missingSrc>fail</missingSrc>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/libexec/sokar</prefix>
                                        <user>root</user>
                                        <group>root</group>
                                        <filemode>755</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/../app/target/bom.json</src>
                                    <type>file</type>
                                    <missingSrc>fail</missingSrc>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/doc/sokar-message-sluice-filter</prefix>
                                        <user>root</user>
                                        <group>root</group>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/../../dist-common/copyright</src>
                                    <type>file</type>
                                    <missingSrc>fail</missingSrc>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/doc/sokar-message-sluice-filter</prefix>
                                        <user>root</user>
                                        <group>root</group>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
